                                "assetId": {
                                  "type": "string"
                                },
                                "alt": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "assetId",
                                "alt"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "title",
                        "description",
                        "noindex",
                        "image"
                      ]
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "visible": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "visible"
                        ]
                      }
                    },
                    "content": {
                      "type": "object",
                      "properties": {
                        "headline": {
                          "type": "string"
                        },
