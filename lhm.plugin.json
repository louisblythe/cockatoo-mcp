                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "assetId": {
                                "type": "string"
                              },
                              "alt": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "assetId",
                              "alt"
                            ]
                          }
                        }
                      },
                      "required": [
                        "headline",
                        "introduction",
                        "about",
                        "services",
                        "gallery"
                      ]
                    },
                    "layout": {}
                  },
                  "required": [
                    "id",
                    "title",
                    "slug",
                    "isHome",
                    "showInNav",
                    "status",
                    "seo",
                    "sections",
                    "content"
                  ]
