    {
      "name": "start_onboarding",
      "description": "Create the user's website. Saves the document as a private draft and returns an approvalUrl; give that link to the user, who signs in with this email and approves to publish. No account or email verification is needed on your side, and no email is sent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "agentName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "document": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 1
              },
              "template": {
                "type": "string"
              },
              "industry": {
                "type": "string"
              },
              "businessName": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "introduction": {
                "type": "string"
              },
              "about": {
                "type": "string"
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "bookingUrl": {
                "type": "string"
              },
              "hours": {
                "type": "string"
              },
              "serviceArea": {
                "type": "string"
              },
              "colour": {
                "type": "string"
              },
              "font": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "logo": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "assetId": {
                        "type": "string"
                      },
                      "alt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "assetId",
                      "alt"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gallery": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "assetId",
                    "alt"
                  ]
                }
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "visible"
                  ]
                }
              },
              "blockLayout": {},
              "layout": {},
              "pages": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "blockPageId": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9-]{1,64}$"
