    {
      "name": "catalog",
      "description": "Start here to build a website. Returns templates, industries, style presets and a complete starter document to fill in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
